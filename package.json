{
  "name": "books",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "江栖文集 —— 个人诗文文集静态站点",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && node scripts/check-content.mjs",
