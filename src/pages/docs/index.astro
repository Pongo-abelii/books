---
import Base from '../../layouts/Base.astro';
import EntryList from '../../components/EntryList.astro';
import { published } from '../../lib/content';
import { SECTIONS } from '../../consts';

const items = await published('docs');
const meta = SECTIONS.docs;
---

<Base title={meta.name} description={meta.desc} path="/docs/">
  <h1>{meta.name}</h1>
  <p style="color:var(--fg-mute);font-family:var(--sans);font-size:.85rem">
    {meta.desc}　共 {items.length} 篇
  </p>
  <EntryList items={items.map((entry) => ({ section: 'docs' as const, entry }))} />
</Base>
