---
/**
 * 授权声明条
 */
import { getLicense, licenseStatement } from '../lib/license';

interface Props {
  licenseId: string;
  url: string;
  section: string;
  author: string;
}
const { licenseId, url, section, author } = Astro.props;
const info = getLicense(licenseId);
const statement = licenseStatement(licenseId, url, section, author).split('\n');
---

<div class="license-bar">
  <p>
    <span class="lic-name">{info.name}</span>
    {info.url ? <a href={info.url} rel="license noopener" target="_blank">协议原文</a> : null}
  </p>
  {statement.map((line) => <p>{line}</p>)}
</div>
